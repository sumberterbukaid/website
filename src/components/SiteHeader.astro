---
// Header atas: di mobile hanya logo + ikon cari (navigasi utama pindah ke
// BottomNav — pola mobile-first untuk pengguna Indonesia). /forks sengaja
// tidak di nav (SPEC: itu changelog komunitas, ada di footer).
const nav = [
  { href: '/kabarmutu/', label: 'Kabarmutu' },
  { href: '/lab/', label: 'Lab' },
  { href: '/pustaka/', label: 'Pustaka' },
  { href: '/hackathon/', label: 'Hackathon' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="container inner">
    <a class="logo" href="/" aria-label="Sumber Terbuka — beranda">
      <span class="prompt">~/</span>sumberterbuka<span class="tld">.id</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      {
        nav.map((item) => (
          <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href="/cari/" class="nav-search" aria-label="Cari" aria-current={isCurrent('/cari/') ? 'page' : undefined}>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </a>
    </nav>
  </div>
</header>
