---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  hideTitle?: boolean;
}

const { headings, hideTitle = false } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 && (
    <nav class="toc" aria-label="Daftar isi">
      {!hideTitle && <h2>Daftar isi</h2>}
      <ol>
        {items.map((h) => (
          <li data-depth={h.depth}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
