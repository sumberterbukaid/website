# Salin ke .env dan isi sesuai kebutuhan. Semua opsional — situs jalan
# tanpa ini (form/kanal menampilkan status "menyusul").

# Domain Plausible untuk analitik ramah privasi (tanpa cookie)
PUBLIC_PLAUSIBLE_DOMAIN=

# Endpoint form newsletter (mis. Buttondown)
PUBLIC_NEWSLETTER_ENDPOINT=

# Tautan formulir pendaftaran Hack Sprint (Tally/Google Form)
PUBLIC_HACKATHON_FORM_URL=
